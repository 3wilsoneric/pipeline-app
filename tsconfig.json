{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "tsBuildInfoFile": ".next/cache/tsconfig.tsbuildinfo",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*",
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-desktop-e2e/types/**/*.ts",
    ".next-desktop-e2e/dev/types/**/*.ts",
    ".next-visual-e2e/types/**/*.ts",
    ".next-visual-e2e/dev/types/**/*.ts",
    ".next-visual-linux/types/**/*.ts",
    ".next-visual-linux/dev/types/**/*.ts",
    ".next-desktop-e2e-repeat/types/**/*.ts",
    ".next-desktop-e2e-repeat/dev/types/**/*.ts",
    ".next-assessment-practice-e2e/types/**/*.ts",
    ".next-assessment-practice-e2e/dev/types/**/*.ts",
    ".next-note-lab-e2e/types/**/*.ts",
    ".next-note-lab-e2e/dev/types/**/*.ts",
    ".next-responsive-e2e/types/**/*.ts",
    ".next-responsive-e2e/dev/types/**/*.ts",
    ".next-training-e2e/types/**/*.ts",
    ".next-training-e2e/dev/types/**/*.ts",
    ".next-calendar-e2e/types/**/*.ts",
    ".next-calendar-e2e/dev/types/**/*.ts",
    ".next-home-e2e/types/**/*.ts",
    ".next-home-e2e/dev/types/**/*.ts",
    ".next-training-e2e-final/types/**/*.ts",
    ".next-training-e2e-final/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next-*",
    "build",
    "coverage",
    "out",
    "playwright-report",
    "test-results",
    "tmp"
  ]
}
