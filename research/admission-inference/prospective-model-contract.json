  "outcomes": [
    {
      "name": "supervisor_decision",
      "availability": "current",
      "values": ["accepted", "declined"],
      "purpose": "Historical decision-pattern research only; never presented as an admission recommendation."
    },
    {
      "name": "needs_more_information",
      "availability": "current",
      "values": ["yes", "no"],
      "purpose": "Measure assessment completeness and avoidable rework."
    },
    {
      "name": "decision_lag_hours",
      "availability": "current",
      "purpose": "Operational outcome, not a clinical target."
    },
    {
      "name": "admitted_within_30_days",
      "availability": "derivable_when_admission_date_is_verified",
      "values": ["yes", "no"],
      "purpose": "Measure whether an acceptance produced a completed placement."
    },
    {
      "name": "placement_stable_30_days",
      "availability": "planned_ehr_follow_up",
      "values": ["yes", "no"],
      "purpose": "Preferred early placement-fit outcome."
    },
    {
      "name": "placement_stable_90_days",
      "availability": "planned_ehr_follow_up",
      "values": ["yes", "no"],
      "purpose": "Preferred longitudinal placement-fit outcome."
    },
    {
      "name": "higher_level_of_care_transfer_90_days",
      "availability": "planned_ehr_follow_up",
      "values": ["yes", "no"],
      "purpose": "Identify support mismatches without treating them as personal eligibility scores."
    }
  ],
  "model_families": [
    {
      "name": "assessment_rework",
      "target": "needs_more_information",
      "first_method": "regularized logistic regression",
      "future_help": "Show missing or conflicting evidence before sign-off."
    },
    {
      "name": "historical_decision_pattern",
      "target": "supervisor_decision",
      "first_method": "regularized logistic regression with process negative control",
      "future_help": "Research and audit only; never expose as an admission score."
    },
    {
      "name": "placement_conversion",
      "target": "admitted_within_30_days",
      "first_method": "time-to-event model with competing outcomes",
      "future_help": "Identify operational and support barriers after acceptance."
    },
    {
      "name": "placement_stability",
      "target": "placement_stable_30_days and placement_stable_90_days",
      "first_method": "calibrated time-to-event model",
      "future_help": "Summarize likely support needs with abstention and source evidence."
    }
  ],
  "readiness_thresholds": {
    "minimum_signed_episodes": 400,
    "minimum_per_decision_outcome": 100,
    "minimum_calendar_months": 3,
    "minimum_communities": 3,
    "maximum_core_field_missingness": 0.3,
    "minimum_cell_size": 5
  },
  "required_validation": [
    "person-grouped splits",
    "future-time holdout",
    "leave-one-community-out evaluation",
    "assessor holdout",
    "calibration with confidence intervals",
    "missingness and provenance audit",
    "protected-attribute fairness audit outside the predictor matrix",
    "silent shadow evaluation before any user-facing assistance"
  ]
}
