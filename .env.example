# Azure Blob Storage
PIPELINE_EXTRACTION_BACKEND=mock
# Development-only local OCR reads the initial intake pages and preserves the
# full original under PIPELINE_LOCAL_DOCUMENT_ROOT. Production ignores this
# path and uses the Azure/Databricks extraction backend.
PIPELINE_LOCAL_DOCUMENT_ROOT=.data/documents
PIPELINE_LOCAL_OCR_MAX_PAGES=3
# local_file is for one local app instance only. Production must use postgres.
PIPELINE_REFERRAL_STORE_MODE=local_file
# Assessment records use the same replaceable-store pattern. Set postgres in
# production so lists, edits, provenance, and audit events are shared.
PIPELINE_ASSESSMENT_STORE_MODE=local_file
PIPELINE_ASSESSMENT_STORE_PATH=.data/assessments.json
# Reviewed Alamo-to-Pipeline identity links. Production uses the shared
# PostgreSQL adapter; local_file is limited to one development instance.
PIPELINE_RESIDENT_LINK_STORE_MODE=local_file
PIPELINE_RESIDENT_LINK_STORE_PATH=.data/resident-links.json

# Pipeline transactional database. This URL is server-only and must never be
# copied into a NEXT_PUBLIC variable. Use an Azure Database for PostgreSQL URL.
PIPELINE_DATABASE_MODE=disconnected
PIPELINE_DATABASE_URL=
PIPELINE_DATABASE_SSL_MODE=require
PIPELINE_DATABASE_POOL_MAX=5
PIPELINE_DATABASE_CONNECT_TIMEOUT_SECONDS=10
PIPELINE_DATABASE_IDLE_TIMEOUT_SECONDS=20
PIPELINE_DATABASE_MAX_LIFETIME_SECONDS=1800
# Per-process defense-in-depth limits. A distributed edge rate limit is still
# required in production; these caps keep one app instance from being flooded
# by concurrent expensive work while returning a bounded 429 + Retry-After.
PIPELINE_MAX_CONCURRENT_READS=100
PIPELINE_MAX_CONCURRENT_MUTATIONS=40
PIPELINE_MAX_CONCURRENT_UPLOADS=4
PIPELINE_MAX_CONCURRENT_WORKERS=8
# Production store settings:
# PIPELINE_REFERRAL_STORE_MODE=postgres
# PIPELINE_ASSESSMENT_STORE_MODE=postgres
# PIPELINE_RESIDENT_LINK_STORE_MODE=postgres

# Future new-client and assessment increments remain disabled until Alamo
# approves the Databricks publication workflow. Enabling requires both values.
PIPELINE_CLIENT_INCREMENTAL_UPDATES_ENABLED=false
PIPELINE_CLIENT_INCREMENTAL_UPDATES_APPROVAL=

# Optional installable desktop/PWA distribution. These flags are off by
# default, so the standard web deployment does not register a service worker
# or use server-backed browser recovery state. Enable both in the same release.
NEXT_PUBLIC_PIPELINE_DESKTOP_ENABLED=false
PIPELINE_DESKTOP_STATE_ENABLED=false
# Development and Playwright only. Production desktop state requires the
# shared PostgreSQL database and migration 0006.
PIPELINE_ALLOW_LOCAL_DESKTOP_STATE_STORE=false
PIPELINE_DESKTOP_STATE_STORE_PATH=.data/desktop-workspace-state.json
# Set to azure_databricks in production. Mock is blocked in production unless
# PIPELINE_ALLOW_PRODUCTION_MOCK_EXTRACTION=true is explicitly set for a break-glass demo.
PIPELINE_ALLOW_PRODUCTION_MOCK_EXTRACTION=false

# Legacy compatibility flag. Runtime client-profile fixtures have been removed.
PIPELINE_ENABLE_SYNTHETIC_PROFILES=false

# Clinical data is served by the governed Alamo Platform snapshot/API. Keep
# this server-side; the browser must never receive EHR/eMAR credentials.
# Local development stays disconnected until an explicit upstream is set.
# A one-time governed CSV export may use demo_snapshot locally. This mode is
# blocked in production and the generated JSON stays under ignored .data/.
PIPELINE_CLINICAL_DATA_MODE=disconnected
# Set true only when the governed Alamo API is part of this deployment's
# readiness contract. Disconnected routes still fail closed when this is false.
PIPELINE_CLINICAL_DATA_REQUIRED=false
PIPELINE_CLINICAL_DEMO_SNAPSHOT_PATH=.data/demo-clinical-snapshot.json
# Optional development-only longitudinal enrichment. Production must receive
# this history through Alamo rather than mounting the local snapshot.
PIPELINE_CLIENT_HISTORY_MODE=disconnected
PIPELINE_CLIENT_HISTORY_SNAPSHOT_PATH=.data/master-client-history.json
PIPELINE_ALAMO_API_BASE_URL=
# Production default: service-to-service Entra client credentials.
PIPELINE_ALAMO_AUTH_MODE=client_credentials
PIPELINE_ALAMO_TENANT_ID=
PIPELINE_ALAMO_CLIENT_ID=
PIPELINE_ALAMO_CLIENT_SECRET=
# Use the Alamo API resource's .default scope, for example api://<app-id>/.default.
PIPELINE_ALAMO_API_SCOPE=
# Development-only bearer mode. Production rejects PIPELINE_ALAMO_AUTH_MODE=bearer.
PIPELINE_ALAMO_API_TOKEN=
PIPELINE_CLINICAL_TIMEOUT_MS=10000
PIPELINE_CLINICAL_MAX_RESPONSE_BYTES=2097152

AZURE_STORAGE_ACCOUNT=
# Production uses the Container App's user-assigned managed identity to obtain
# user-delegation keys and mint short-lived, per-blob SAS URLs. AZURE_CLIENT_ID
# selects that identity. Shared storage-account keys are intentionally unsupported.
PIPELINE_AZURE_BLOB_AUTH_MODE=managed_identity
AZURE_CLIENT_ID=
AZURE_STORAGE_CONTAINER_RAW=raw
AZURE_STORAGE_CONTAINER_NORMALIZED=normalized
AZURE_STORAGE_CONTAINER_OCR=ocr
AZURE_STORAGE_CONTAINER_EVIDENCE=evidence
AZURE_STORAGE_CONTAINER_ARTIFACTS=artifacts
PIPELINE_UPLOAD_URL_TTL_SECONDS=900
PIPELINE_PREVIEW_MAX_BYTES=26214400

# Databricks
DATABRICKS_HOST=
DATABRICKS_JOB_ID=
PIPELINE_DATABRICKS_AUTH_MODE=oauth_m2m
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
PIPELINE_DATABRICKS_TIMEOUT_MS=10000
PIPELINE_DATABRICKS_MAX_RESPONSE_BYTES=1048576

# Internal Container Apps Job authentication. Use separate random values in
# production unless the deployment intentionally standardizes on CRON_SECRET.
PIPELINE_WORKER_SHARED_SECRET=
CRON_SECRET=

# Worker-only secrets. Put these in Databricks secret scope or Key Vault.
# Azure Document Intelligence
DOCUMENT_INTELLIGENCE_ENDPOINT=

# Claude / Anthropic
ANTHROPIC_API_KEY=

# Pipeline auth / Microsoft Entra integration
# Local demos may use mock. Production must use entra_jwt.
# Alamo aggregate overview and analytics remain in the main platform app.
NEXT_PUBLIC_ALAMO_PLATFORM_URL=https://www.alamoplatform.com
# Optional compatibility path for local integration tests. Production Pipeline
# is deployed at its own origin and leaves this blank.
NEXT_PUBLIC_PIPELINE_BASE_PATH=
NEXT_PUBLIC_ENTRA_TENANT_ID=
NEXT_PUBLIC_ENTRA_CLIENT_ID=
NEXT_PUBLIC_PIPELINE_API_SCOPE=api://<PIPELINE_APP_ID>/access_as_user
# false for local mock mode; true only after the SPA registration and API scope are configured.
NEXT_PUBLIC_PIPELINE_AUTH_REQUIRED=false

PIPELINE_AUTH_MODE=mock
PIPELINE_ENTRA_TENANT_ID=
# Pipeline requests v2 access tokens, whose aud claim is the plain API client ID GUID.
PIPELINE_ENTRA_API_AUDIENCE=<PIPELINE_APP_ID>
PIPELINE_ENTRA_API_SCOPE=access_as_user
# At least 32 random characters. Server-only; never use NEXT_PUBLIC_ here.
PIPELINE_ENTRA_SESSION_SECRET=
# Comma-separated exact origins accepted for browser mutations behind a reverse proxy.
# Local development needs no override because the request URL origin is always accepted.
PIPELINE_ALLOWED_MUTATION_ORIGINS=https://alamoplatform.com,https://www.alamoplatform.com
# Optional trusted gateway mode for legacy headers. Keep false when Pipeline validates JWTs itself.
PIPELINE_TRUSTED_GATEWAY=false
# Only true for loopback Playwright/local production smoke tests. Never enable on a deployment.
PIPELINE_ALLOW_PRODUCTION_MOCK_AUTH=false

PIPELINE_MOCK_USER_EMAIL=demo@pipeline.local
PIPELINE_MOCK_USER_NAME=Eric Wilson
# Comma-separated local demo roles. Defaults to assessment_coordinator,reviewer,viewer.
PIPELINE_MOCK_USER_ROLES=assessment_coordinator,reviewer,viewer
# Legacy EasyAuth header compatibility. Production requires PIPELINE_TRUSTED_GATEWAY=true to use it.
PIPELINE_ALLOW_UNVERIFIED_AUTH_HEADERS=false
# Optional trusted-gateway allowlists. They are not part of the production Entra JWT path.
PIPELINE_ALLOWED_EMAILS=
PIPELINE_ALLOWED_ENTRA_OBJECT_IDS=
PIPELINE_ADMIN_EMAILS=
PIPELINE_COORDINATOR_EMAILS=
PIPELINE_REVIEWER_EMAILS=

# Optional local/deployed load smoke. The script refuses remote targets unless
# the explicit opt-in is set. These are test controls, not runtime settings.
PIPELINE_LOAD_BASE_URL=
PIPELINE_LOAD_ALLOW_REMOTE=false
PIPELINE_LOAD_REQUESTS=100
PIPELINE_LOAD_CONCURRENCY=10
# Optional trusted-gateway identity used only when load-testing header auth.
PIPELINE_LOAD_USER_EMAIL=

# Collaboration and database operations are operator-run controls, not normal
# application runtime settings. Always use a disposable PostgreSQL database for
# fixtures and rollback drills.
PIPELINE_COLLABORATION_BASE_URL=
PIPELINE_COLLABORATION_REQUIRE_POSTGRES=false
PIPELINE_COLLABORATION_REQUIRE_DESKTOP_STATE=false
PIPELINE_TEST_DATABASE_URL=
PIPELINE_ALLOW_TEST_DATABASE_REUSE=false
PIPELINE_ALLOW_MIGRATION_ROLLBACK_DRILL=false
# Logical recovery commands. Restore verification is destructive to the
# Pipeline schema in PIPELINE_TEST_DATABASE_URL and requires explicit opt-in.
PIPELINE_ALLOW_RESTORE_DRILL=false
# Optional operator overrides when PostgreSQL client tools are not on PATH.
PG_DUMP_PATH=
PG_RESTORE_PATH=
# Execution still requires the command-line confirmation token.
PIPELINE_PILOT_RESET_ENABLED=false
# Per-user recents/draft removal is dry-run-first and additionally requires the
# command-line confirmation token documented in DATABASE_RECOVERY.md.
PIPELINE_WORKSPACE_PURGE_PRINCIPAL_ID=
PIPELINE_ALLOW_USER_STATE_PURGE=false

# Optional CI artifact budgets. Defaults are intentionally conservative and
# can be tightened after production telemetry establishes a stable baseline.
PIPELINE_BUILD_MAX_STATIC_BYTES=10485760
PIPELINE_BUILD_MAX_JS_BYTES=1048576
PIPELINE_BUILD_MAX_CSS_BYTES=524288
PIPELINE_BUILD_MAX_GZIP_CODE_BYTES=3145728
