{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "changes", "tests", "blockers", "nextSteps"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["ready_for_review", "in_progress", "blocked"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "changes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "tests": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "blockers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "nextSteps": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
