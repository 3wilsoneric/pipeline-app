{
  "name": "pipeline-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "check:platform": "node scripts/platform-readiness.mjs",
    "check:platform:fast": "node scripts/platform-readiness.mjs --skip-build",
    "check:admissions-zone": "node scripts/admissions-zone-contracts.mjs",
    "check:api": "node scripts/api-behavior-fixtures.mjs",
    "check:clinical": "node scripts/clinical-data-contracts.mjs && node scripts/demo-clinical-snapshot-contracts.mjs && node scripts/client-history-contracts.mjs",
    "check:clinical-presentation": "node scripts/clinical-value-presentation-contracts.mjs",
    "clinical:demo:import": "node scripts/import-demo-clinical-roster.mjs",
    "client-history:import": "node scripts/import-master-client-history.mjs",
    "data:local:reset-synthetic": "node scripts/reset-local-synthetic-data.mjs",
    "data:local:import-referrals": "node scripts/import-local-referral-packets.mjs",
    "check:database": "node scripts/database-readiness.mjs",
    "check:client-workspaces": "node scripts/client-workspace-contracts.mjs",
    "check:database:live": "node scripts/postgres-live-smoke.mjs",
    "check:deployment": "node scripts/deployment-readiness.mjs",
    "check:security": "node scripts/security-boundary-check.mjs",
    "check:route-policy": "node scripts/api-route-policy-audit.mjs",
    "check:licenses": "node scripts/license-policy-audit.mjs",
    "check:supply-chain": "node scripts/supply-chain-readiness.mjs",
    "check:desktop": "node scripts/desktop-readiness.mjs",
    "check:artifacts": "node scripts/build-artifact-audit.mjs",
    "check:load": "node scripts/http-load-smoke.mjs",
    "check:collaboration-load": "node scripts/collaboration-load-smoke.mjs",
    "check:scale": "node scripts/synthetic-scale-benchmark.mjs",
    "check:extraction": "node scripts/extraction-state-machine-replay.mjs",
    "check:extraction-worker": "node scripts/pipeline-extraction-worker-contracts.mjs",
    "check:sample-packet": "node scripts/sample-packet-extraction-smoke.mjs",
    "check:queries": "node scripts/query-plan-audit.mjs",
    "check:infrastructure": "node scripts/infrastructure-readiness.mjs",
    "check:metrics": "node scripts/operational-metrics-readiness.mjs",
    "check:performance": "node scripts/pipeline-performance-scorecard.mjs",
    "check:mcmaster:matrix": "node scripts/mcmaster-certification-matrix.mjs",
    "check:mcmaster:contracts": "node scripts/mcmaster-performance-contracts.mjs",
    "check:mcmaster": "npm run check:mcmaster:matrix && npm run check:mcmaster:contracts",
    "certify:mcmaster:performance": "node scripts/mcmaster-certification-runner.mjs",
    "certify:mcmaster": "npm run check:mcmaster && npm run check:platform:fast && npm run build && npm run check:artifacts && npm run test:e2e && npm run certify:mcmaster:performance && npm run test:e2e:desktop && npm run test:e2e:cross-browser && npm run test:e2e:visual",
    "check:alerts": "node scripts/alerting-readiness.mjs",
    "check:properties": "node scripts/property-contracts.mjs",
    "check:extraction-quality": "node scripts/extraction-quality-score.mjs",
    "check:backlog-rehearsal": "node scripts/backlog-rehearsal.mjs",
    "check:recovery": "node scripts/recovery-readiness.mjs",
    "check:retention": "node scripts/workspace-retention-readiness.mjs",
    "check:release": "node scripts/release-compatibility.mjs",
    "database:migrate": "node scripts/apply-database-migrations.mjs",
    "database:migrate:plan": "node scripts/apply-database-migrations.mjs --plan",
    "database:migrate:verify:0007": "node scripts/verify-database-migration-0007.mjs",
    "database:fixtures": "node scripts/postgres-integration-fixtures.mjs",
    "database:rollback:drill": "node scripts/database-rollback-drill.mjs",
    "database:seed:production": "node scripts/seed-production-reference-data.mjs",
    "database:pilot:reset": "node scripts/pilot-reset.mjs",
    "database:user-state:purge": "node scripts/purge-user-workspace-state.mjs",
    "database:backup": "node scripts/database-backup.mjs",
    "database:backup:azure": "node scripts/database-backup-to-azure-blob.mjs",
    "database:restore:verify": "node scripts/database-restore-verify.mjs",
    "release:manifest": "node scripts/create-release-manifest.mjs",
    "release:sbom": "node scripts/generate-sbom.mjs",
    "release:evidence": "node scripts/create-release-evidence.mjs",
    "release:evidence:verify": "node scripts/verify-release-evidence.mjs",
    "check:journeys": "node scripts/referral-journey-replay.mjs",
    "check:reliability": "node scripts/referral-reliability-replay.mjs",
    "check:failures": "node scripts/failure-recovery-readiness.mjs",
    "check:chaos": "node scripts/chaos-recovery-replay.mjs",
    "manifest:packets": "node scripts/create-batch-manifest.mjs",
    "client-files:manifest": "node scripts/create-client-file-import-manifest.mjs",
    "client-files:stage": "node scripts/stage-client-file-import.mjs",
    "client-files:import": "node scripts/import-confirmed-client-files.mjs",
    "start": "node scripts/start-standalone.mjs",
    "test:e2e": "playwright test",
    "test:e2e:desktop": "PIPELINE_NEXT_DIST_DIR=.next-desktop-e2e PIPELINE_DESKTOP_E2E=true PORT=3189 playwright test tests/e2e/desktop-readiness.spec.ts --project=chromium",
    "test:e2e:cross-browser": "PIPELINE_CROSS_BROWSER=true playwright test tests/e2e/cross-browser-smoke.spec.ts",
    "test:e2e:visual": "PIPELINE_NEXT_DIST_DIR=.next-visual-e2e PIPELINE_VISUAL_REGRESSION=true PORT=3193 playwright test tests/e2e/visual-regression.spec.ts --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@azure/msal-browser": "^4.30.0",
    "@azure/msal-react": "^3.0.29",
    "@azure/storage-blob": "^12.33.0",
    "@napi-rs/canvas": "^1.0.5",
    "@tesseract.js-data/eng": "^1.0.0",
    "jose": "^6.2.8",
    "lucide-react": "^0.577.0",
    "next": "16.2.11",
    "pdfjs-dist": "^6.2.108",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.37",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.11.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  }
}
